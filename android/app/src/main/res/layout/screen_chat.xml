<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

<!-- V5 Phase B C2 (batch 2, step 4): 内标题行已删——V5 C2-3-R4 起
         顶栏是品牌行（汉堡 / ∞ / WhereverCode / V5 / 搜索 / 铃铛），
         留着内标题行就是双顶栏。 -->
    <!-- 阶段 3（U4）：审批等待提示条（含剩余秒数倒计时），由 MainActivity 每秒刷新；无等待审批时隐藏。 -->
    <TextView
        android:id="@+id/approvalBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chip_home"
        android:padding="10dp"
        android:textColor="@color/home_warning"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 阶段 A（V5 紧急开发）：聊天顶部“当前设备 · 对话方”横幅。
         选了 Agent 却不知道消息发给谁就是本次 bug 的表象；横幅由
         MainActivity.updateChatRouteBanner() 每次渲染时刷新。
         内标题行已删（C2 双顶栏），这行是状态显示，不是标题。 -->
    <TextView
        android:id="@+id/chatRouteBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chip_home"
        android:padding="10dp"
        android:textColor="@color/home_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/modelConnectionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_chip_warning"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:text="还没有连接 AI 模型　连接 ›"
        android:textColor="@color/home_warning"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 阶段 3（U4）：聊天页内控制行。运行中显示暂停/停止/改目标/控制台；
         已暂停显示继续/改目标/控制台；空闲时隐藏。
         V5 C2-3-R1: 照 v2-02 / V5 原型图，一行等宽 pill；停止红字红边。 -->
    <LinearLayout
        android:id="@+id/chatControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/buttonChatPause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_home"
            android:gravity="center"
            android:text="暂停"
            android:textColor="@color/home_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/buttonChatStop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_danger_outline"
            android:gravity="center"
            android:text="停止"
            android:textColor="@color/home_danger"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/buttonChatResume"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_home"
            android:gravity="center"
            android:text="继续"
            android:textColor="@color/home_link"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/buttonChatChangeGoal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_home"
            android:gravity="center"
            android:text="改目标"
            android:textColor="@color/home_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/buttonChatConsole"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_home"
            android:gravity="center"
            android:text="控制台"
            android:textColor="@color/home_text"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 对话组件收敛（2026-11-20）：消息列表宿主与频道页共用
             MessageListView；内层 ScrollView / LinearLayout 不再挂
             chatScroll / messageList id（布局里无此声明），
             MainActivity 改走宿主的 scrollView / content 属性；
             原 XML 呈现（无滚动条、clipToPadding=false、内容
             padding 14/4/14/16）改由 MainActivity.bindChat 配置。 -->
        <wherevercode.agent.ui.MessageListView
            android:id="@+id/messageListHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 阶段 3（U6）：回到底部按钮；仅在用户上滑离开底部时显示。 -->
        <TextView
            android:id="@+id/buttonScrollBottom"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_chip_home"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="↓ 回到底部"
            android:textColor="@color/home_link"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- V5 C2-3-R4（v4.3-01 左半屏）：双层输入区——上层只有输入框
         （hint 与发送逻辑不动），下层一行：+ / 团队下拉 / 发送。
         附件 / 文件夹 / 参数·权限三个隐藏按钮已随“+”菜单重做删掉
         （V5 输入框 + 菜单重做，Claude 参照，maintainer 2026-11-11）：
         附件与参数·权限没有真实接线（只会 toast 死提示），文件夹
         是项目入口的重复副本且从未接线——项目入口在“+”菜单的项目
         格子与抽屉里。每个控件要么接真实动作，要么不存在，绝无死
         按钮。窄屏适配：下层固定 36dp 控件 + 团队下拉 + 发送，
         320dp 宽下不溢出（见 MainLayoutTest 的 320dp 布局测试）。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <!-- 对话组件收敛（2026-11-20）：输入区骨架与频道页共用
             ChatComposerView（STACKED 排布：输入框 + 下层控制行 +
             发送钮由组件内建，沿用 inputPrompt / inputLowerRow /
             buttonSend id）；页面外壳控件（contextPill 与下层行四
             控件）仍在 XML 里声明（属性逐字沿用组件化之前），
             充气时先挂在本组件下，组件 onFinishInflate 按 id 把
             它们收编进上层插槽 / 下层行，父子结构与原 XML 一致
             （MainLayoutTest 按此结构校验）。+ 号开上下文菜单；
             麦克风不做（V5-UI.md §二原文“可选麦克风”），不留假按钮。 -->
        <wherevercode.agent.ui.ChatComposerView
            android:id="@+id/inputBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input_home"
            android:padding="4dp"
            app:composerArrangement="stacked">

            <TextView
                android:id="@+id/contextPill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_chip_home"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="本机 · App 沙盒 ⌄"
                android:textColor="@color/home_text"
                android:textSize="12sp"
                android:contentDescription="当前项目上下文" />

            <TextView
                android:id="@+id/buttonPlus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="＋"
                android:textColor="@color/home_text_secondary"
                android:textSize="18sp"
                android:background="@drawable/bg_chip_home"
                android:contentDescription="更多操作" />

            <TextView
                android:id="@+id/buttonAgentSelect"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_home"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="选择对话方 ⌄"
                android:textColor="@color/home_text"
                android:textSize="12sp"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:contentDescription="选择对话方" />

            <TextView
                android:id="@+id/buttonDictateDraft"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="🎙"
                android:contentDescription="语音输入" />

            <TextView
                android:id="@+id/brainCapsule"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="未连接"
                android:visibility="gone" />

            <TextView
                android:id="@+id/buttonTaskMark"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="任务"
                android:visibility="gone" />

        </wherevercode.agent.ui.ChatComposerView>

        <!-- V5 聊天清理 20261111：底部常驻小字已删（“同一时刻只跑一轮 ·
             写文件/命令执行前会弹审批”）——审批提示只在真正要审批时弹，
             不常驻占位置；上一轮还在执行时发送门控会如实提示。 -->
    </LinearLayout>
</LinearLayout>
