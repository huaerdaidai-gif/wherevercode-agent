<?xml version="1.0" encoding="utf-8"?>
<!-- UI V2 shell: one activity, a single minimal chat home plus a nestable
     left drawer (V5-UI.md). The screens are inflated into screenContainer
     (see MainActivity); there is no bottom navigation bar (removed in
     V5 Phase B C2 batch 2, step 4). Top bar (2026-11-16, aligned with
     the iOS home): hamburger only on the left — the brand row
     (infinity mark / WhereverCode / V5) is gone, branding lives in
     the drawer header and the welcome area; right side: search and
     new-conversation icon buttons. The notification bell was removed
     with the brand row: it only ever showed a "待开发" toast, a
     dead-end entry, and there is still no notification feature.
     Sized for a K70-class 360dp-wide portrait screen.
     V5 Phase B C2 (batch 2): the root is a FrameLayout so the drawer
     (drawerContainer + drawerScrim) can overlay the shell; the drawer
     opens only from the hamburger button (buttonMenu), no edge swipe. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/home_bg"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- V5 Phase B C2 (batch 2): hamburger opens the drawer. Text glyph:
             no hamburger drawable exists in this tree; do not reference one.
             2026-11-16 (照 iOS 首页): the top bar carries no brand text —
             left is the hamburger alone, the middle is empty, and the
             right side holds two real actions: search (session list)
             and new conversation. -->
        <TextView
            android:id="@+id/buttonMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/home_text"
            android:textSize="20sp"
            android:contentDescription="打开抽屉"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 顶栏搜索：点按进会话列表（真实入口，非装饰）。 -->
        <ImageView
            android:id="@+id/buttonSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_search"
            android:contentDescription="会话"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- 顶栏新建对话（2026-11-16 照 iOS 首页补回）：与抽屉「＋ 新对话」
             同一动作（MainActivity.newConversationAndShow）。Text glyph:
             no edit/pencil drawable exists in this tree. -->
        <TextView
            android:id="@+id/buttonNew"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✎"
            android:textColor="@color/home_text"
            android:textSize="17sp"
            android:contentDescription="新对话"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/screenContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    </LinearLayout>

    <!-- V5 Phase B C2 (batch 2): drawer overlay. The scrim dims the shell
         and closes the drawer on tap; the panel slides in from the left
         (translationX animation in MainActivity). -->
    <View
        android:id="@+id/drawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/drawerContainer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/nav_bg"
        android:elevation="16dp"
        android:visibility="gone" />
</FrameLayout>
