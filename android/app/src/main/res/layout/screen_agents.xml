<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/agentHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/agentScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agent"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/agentIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="已添加的 Agent 在此管理；远程设备上的 Agent 需先在设备页添加设备。"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/buttonAgentRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="刷新 Agent 列表"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonAddAgent"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_accent"
            android:text="＋ 添加 Agent"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agentAddIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="添加云端模型 API、订阅授权 Agent 或本机 CLI Agent；角色不固定，可对话、指派、测试、编辑、移除。"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/agentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:text="正在加载 Agent…"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/deviceSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/deviceSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="本机设备"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/buttonDeviceRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="刷新设备状态"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/deviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">
        </LinearLayout>

    </LinearLayout>
</ScrollView>
