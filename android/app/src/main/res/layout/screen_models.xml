<?xml version="1.0" encoding="utf-8"?>
<!-- 模型页（2026-11-19 解耦）：控制菜单下与设备、Agent 并列的独立一页，
     不再借设置页呈现。上面“添加模型”一块（常用/免费两预设分开、
     自动发现、智能路由、手工表单都在这一块里），下面“已添加模型”
     一块（模型自己的列表，按类型分组）；列表末尾不放添加按钮。
     设置页的大脑分节与本页无关，一字不碰。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="模型"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="添加模型，管理已添加的模型。"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

        <!-- 添加模型块：预设双入口（常用 / 免费 token，两份数据绝不
             合并）、自动发现、智能路由、手工表单，全在这一块里。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="添加模型"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/buttonModelCommonProviders"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:text="常用模型服务商"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/buttonModelFreeProviders"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:text="免费 token 模型服务商"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonModelDiscover"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:text="自动发现设备上的模型"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <!-- 智能路由：总开关默认关；默认只在免费模型之间切，付费须
             用户主动开启才进池。与设置页同一份开关状态（同一 Store）。 -->
        <CheckBox
            android:id="@+id/checkModelRoutingPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="智能路由（自动切换模型）"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/checkModelRoutingAllowPaid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="允许切到付费模型"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="模型额度不足、被限流或出错时，按路由池顺序自动切到下一个。"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/buttonModelRoutingPool"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:text="选择路由池模型"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <!-- 手工添加表单：就在本页添加块里（常用预设选中后也填这里），
             不在下方列表里、更不在设置页。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="手工添加"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="填服务地址、模型与 API Key；Key 只存本机 Keystore。常用预设选中后，名称与服务地址会自动填到这里。"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/modelFormLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="模型名称，如 自建模型"
            android:inputType="textNoSuggestions"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/modelFormBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="Base URL，如 https://api.example.com"
            android:inputType="textUri"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/modelFormModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="模型，如 llama-3"
            android:inputType="textNoSuggestions"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/modelFormApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="API Key（只显示一次）"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/modelFormModels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="点“测试连接”从服务读取可用模型。"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/buttonTestModelModels"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:text="测试连接"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/buttonSaveModel"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_accent"
                android:text="保存模型"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 已添加模型块：模型自己的列表（ModelListRows 按类型分组
             渲染到 modelListContainer），末尾不放添加按钮。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="已添加的模型"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/modelListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:text="正在加载模型…"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
