{
  "name": "a13-report-status",
  "group": "A",
  "description": "Quota report upsert; empty and oversize reports refused.",
  "seed": {
    "agents": [
      {
        "id": "boss",
        "scopes": [
          "owner"
        ],
        "roles": []
      },
      {
        "id": "dev1",
        "scopes": [
          "agent"
        ],
        "roles": [
          "dev"
        ]
      },
      {
        "id": "dev2",
        "scopes": [
          "agent"
        ],
        "roles": [
          "dev"
        ]
      },
      {
        "id": "rev1",
        "scopes": [
          "agent"
        ],
        "roles": [
          "review"
        ]
      }
    ],
    "lease_seconds": 7200
  },
  "steps": [
    {
      "call": {
        "actor": "dev1",
        "tool": "report_status",
        "args": {
          "quota_text": "本周还剩 40%",
          "quota_reset_at": "周二 17:53"
        }
      },
      "expect": {
        "result": {
          "ok": true,
          "quota_text": "本周还剩 40%",
          "quota_reset_at": "周二 17:53",
          "reported_at": "<ts>"
        }
      },
      "state_after": []
    },
    {
      "call": {
        "actor": "dev1",
        "tool": "report_status",
        "args": {}
      },
      "expect": {
        "error": {
          "status": 409,
          "code": "v5_error",
          "message": "quota_text 和 quota_reset_at 至少填一个"
        }
      },
      "state_after": []
    },
    {
      "call": {
        "actor": "dev1",
        "tool": "report_status",
        "args": {
          "quota_text": ""
        }
      },
      "expect": {
        "error": {
          "status": 409,
          "code": "v5_error",
          "message": "quota_text 不能超过 500 个字符"
        }
      },
      "state_after": []
    }
  ]
}